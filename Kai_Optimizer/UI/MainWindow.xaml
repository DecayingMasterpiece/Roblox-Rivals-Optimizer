<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Rivals Optimizer - By Kaiser"
        Height="780" Width="1020"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Color Palette: Black & Hot Pink Theme -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0B12"/>
        <SolidColorBrush x:Key="BgCard" Color="#161624"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#202032"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2C243B"/>
        <SolidColorBrush x:Key="PinkPrimary" Color="#FF2A85"/>
        <SolidColorBrush x:Key="PinkHover" Color="#FF4D9C"/>
        <SolidColorBrush x:Key="PinkPressed" Color="#E01B73"/>
        <SolidColorBrush x:Key="PinkGlow" Color="#55FF2A85"/>
        <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A5A5BA"/>
        <SolidColorBrush x:Key="ConsoleBg" Color="#07070B"/>

        <!-- Standard Button Style -->
        <Style x:Key="PinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PinkPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PinkHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PinkPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outline Button Style -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#221C2E"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource PinkPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#312244"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PinkHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Tab Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C182B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" Background="#161524" BorderBrush="{StaticResource PinkPrimary}" BorderThickness="1.5" CornerRadius="6" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Transparent"/>
                    <Path x:Name="Arrow" Grid.Column="1" Fill="{StaticResource PinkPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#221D34"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PinkHover}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource PinkHover}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#221D34"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#161524"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#35183E"/>
                                <Setter Property="Foreground" Value="{StaticResource PinkPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF2A85"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#161524"/>
            <Setter Property="BorderBrush" Value="{StaticResource PinkPrimary}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="False" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,3,28,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Name="Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#161524" BorderBrush="{StaticResource PinkPrimary}" BorderThickness="1.5" CornerRadius="6" Margin="0,4,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Outer Window Border -->
    <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource PinkPrimary}" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Mode Selector -->
                <RowDefinition Height="*"/>    <!-- Main Content Area -->
                <RowDefinition Height="180"/>  <!-- Console & Bottom Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="10" Width="44" Height="44" Margin="0,0,12,0" BorderBrush="{StaticResource PinkPrimary}" BorderThickness="2" Background="#161524" ClipToBounds="True">
                        <Image x:Name="ImgAppLogo" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ROBLOX RIVALS " FontSize="18" FontWeight="ExtraBold" Foreground="White"/>
                            <TextBlock Text="OPTIMIZER" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource PinkPrimary}"/>
                            <Border Background="#281A36" BorderBrush="{StaticResource PinkPrimary}" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                                <TextBlock Text="v1.0 • @KaiserEverhart" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PinkPrimary}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Universal FPS Unlocker, Input Lag Reducer &amp; Network Latency Stabilizer" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnMinimize" Content="–" Width="32" Height="32" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" FontSize="16" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button x:Name="BtnClose" Content="✕" Width="32" Height="32" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 2. Mode Selector (Simple Mode vs Advanced Mode) -->
            <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnModeSimple" Grid.Column="0" Content="⚡ QUICK OPTIMIZE (1-CLICK SIMPLE MODE)" Height="38" Background="{StaticResource PinkPrimary}" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnModeAdvanced" Grid.Column="1" Content="⚙️ PRO WIZARD (ADVANCED 4-STEP MODE)" Height="38" Background="Transparent" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- 3. Main Content Container -->
            <Grid Grid.Row="2" Margin="0,0,0,14">

                <!-- VIEW A: Simple 1-Click Mode -->
                <Grid x:Name="ViewSimple" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Large Start Action Card -->
                    <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,12,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🚀 MAXIMUM FPS IN 1-CLICK" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Scans your PC, creates a restore point, and applies universal safe optimizations automatically." 
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,24" MaxWidth="420"/>

                            <Button x:Name="BtnStartQuickOptimize" Content="START QUICK OPTIMIZE" Height="60" Width="320"
                                    Background="{StaticResource PinkPrimary}" Foreground="White" FontSize="18" FontWeight="ExtraBold"
                                    Cursor="Hand" Style="{StaticResource PinkButtonStyle}"/>

                            <ProgressBar x:Name="ProgressSimple" Height="8" Width="320" Margin="0,20,0,0" Value="0" Maximum="100" 
                                         Background="#251E33" Foreground="{StaticResource PinkPrimary}" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtSimpleStatus" Text="Ready to boost your game." FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                            <TextBlock Text="✓ 100% Safe Universal Tweaks  •  ✓ Creates System Restore Point" FontSize="11" Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Hardware Diagnostics & What It Does -->
                    <Border Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="🖥️ System Hardware Diagnostics" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                <Border Background="#100F1A" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtDiagOs" Text="OS: Detecting Windows..." FontSize="12" Foreground="White" Margin="0,2"/>
                                        <TextBlock x:Name="TxtDiagGpu" Text="GPU: Detecting Graphics Adapter..." FontSize="12" Foreground="{StaticResource PinkPrimary}" FontWeight="SemiBold" Margin="0,2"/>
                                        <TextBlock x:Name="TxtDiagRam" Text="Memory: Detecting RAM..." FontSize="12" Foreground="White" Margin="0,2"/>
                                        <TextBlock x:Name="TxtDiagRoblox" Text="Roblox: Detecting Client/Bootstrapper..." FontSize="12" Foreground="#4ADE80" Margin="0,2"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="📦 What Quick Optimize Applies:" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock Text="• Windows Game Mode enabled &amp; DVR background capture off" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                                <TextBlock Text="• 1:1 Raw Mouse Aim (Disables Windows Pointer Precision)" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                                <TextBlock Text="• Foreground CPU &amp; DirectX Flip prioritization" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                                <TextBlock Text="• Injects Kaiser's Potato Mode FastFlags (361 FPS cap, low latency)" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                                <TextBlock Text="• Disables Nagle's Algorithm (TcpNoDelay = 1, instant packets)" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                                <TextBlock Text="• Switches to ultra-fast Cloudflare 1.1.1.1 Gaming DNS" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                                <TextBlock Text="• Clears Temp, Prefetch, GPU Shaders &amp; Roblox clutter logs" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- VIEW B: Advanced 4-Step Mode -->
                <Grid x:Name="ViewAdvanced" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Stepper Bar -->
                        <RowDefinition Height="*"/>    <!-- Active Step Content -->
                    </Grid.RowDefinitions>

                    <!-- Stepper Tabs -->
                    <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnTab1" Grid.Column="0" Content="1. Windows &amp; Debloat" Style="{StaticResource TabButtonStyle}" Foreground="{StaticResource PinkPrimary}" FontWeight="Bold"/>
                            <Button x:Name="BtnTab2" Grid.Column="1" Content="2. Rivals FastFlags" Style="{StaticResource TabButtonStyle}"/>
                            <Button x:Name="BtnTab3" Grid.Column="2" Content="3. Wi-Fi &amp; Network" Style="{StaticResource TabButtonStyle}"/>
                            <Button x:Name="BtnTab4" Grid.Column="3" Content="4. NVIDIA &amp; GPU" Style="{StaticResource TabButtonStyle}"/>
                        </Grid>
                    </Border>

                    <!-- STEP 1 PANEL -->
                    <Border x:Name="PanelStep1" Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Step 1: Windows 10 &amp; 11 Optimization &amp; Safe Debloat" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Optimize system settings, reduce telemetry background lag, and fix mouse acceleration." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <CheckBox x:Name="ChkGameMode" Content="Enable Windows Game Mode &amp; Disable DVR Capture" IsChecked="True"/>
                                        <CheckBox x:Name="ChkRawMouse" Content="Disable Mouse Acceleration (1:1 Raw Aim Precision)" IsChecked="True"/>
                                        <CheckBox x:Name="ChkCpuPriority" Content="Tune CPU Priority (Win32PrioritySeparation = 0x26)" IsChecked="True"/>
                                        <CheckBox x:Name="ChkDirectXFlip" Content="Enable DirectX Flip Windowed Optimizations" IsChecked="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <CheckBox x:Name="ChkTelemetry" Content="Disable Telemetry &amp; DiagTrack Background Service" IsChecked="True"/>
                                        <CheckBox x:Name="ChkMenuDelay" Content="Remove Menu &amp; Desktop UI Delays (0ms delay)" IsChecked="True"/>
                                        <CheckBox x:Name="ChkCleanBloat" Content="Remove Preinstalled Sponsored Bloatware (TikTok, etc.)" IsChecked="True"/>
                                        <CheckBox x:Name="ChkTempClean" Content="🧹 Auto-Clean Junk: Prefetch, Temp, Shader Stash &amp; Roblox Logs" IsChecked="True"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BtnApplyStep1" Content="Apply Windows Tweaks" Style="{StaticResource PinkButtonStyle}" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnCleanJunkNow" Content="🧹 Clean Junk &amp; Cache Now" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnCreateRestorePoint" Content="Create System Restore Point" Style="{StaticResource OutlineButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- STEP 2 PANEL -->
                    <Border x:Name="PanelStep2" Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Step 2: Roblox Rivals FastFlags &amp; Bootstrapper Integration" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Inject custom FastFlags for uncapped FPS, lower latency, and competitive texture clarity." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"/>

                                <Border Background="#100F1A" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="SELECT FASTFLAG PRESET:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PinkPrimary}" Margin="0,0,0,8"/>
                                        <RadioButton x:Name="RadioPresetKaiser" Content="🥔 Kaiser's Potato Mode (Ultra Competitive — 361 FPS Cap, RakNet 1240, Shadows Off, Voxel Mode)" Foreground="White" FontSize="12" IsChecked="True" Margin="0,2,0,6"/>
                                        <RadioButton x:Name="RadioPresetSafe" Content="✨ Safe Low Mode (Balanced — 240 FPS Cap, DPI Fix, No PostFX, Clean Standard Textures)" Foreground="White" FontSize="12" Margin="0,2,0,4"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button x:Name="BtnInjectFastFlags" Content="Inject FastFlags Automatically" Style="{StaticResource PinkButtonStyle}" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnCopyFlagsJson" Content="📋 Copy JSON to Clipboard" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnOpenRobloxDir" Content="📁 Open ClientSettings Folder" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnRevertVanillaFlags" Content="Revert to Vanilla" Background="#3A202A" Foreground="#FF809B" BorderThickness="0" Padding="12,7" FontWeight="SemiBold" Cursor="Hand"/>
                                </StackPanel>

                                <Border Background="#14141E" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="ℹ️ Manual Setup Guidance:" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="If you use Bloxstrap, open Fast Flags &gt; Fast Flags Editor &gt; Import JSON (paste copied JSON).&#x0a;If on Vanilla Roblox, place 'ClientAppSettings.json' inside %LocalAppData%\Roblox\ClientSettings." 
                                                   FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- STEP 3 PANEL -->
                    <Border x:Name="PanelStep3" Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Step 3: Wi-Fi, DNS &amp; Network Latency Optimizer" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Eliminate Nagle's algorithm delay, stop periodic Wi-Fi ping spikes, and set competitive DNS." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"/>

                                <StackPanel Margin="0,0,0,16">
                                    <CheckBox x:Name="ChkNagle" Content="Disable Nagle's Algorithm (Sets TcpNoDelay=1 &amp; TcpAckFrequency=1 on all adapters)" IsChecked="True"/>
                                    <CheckBox x:Name="ChkWifiScan" Content="Pause Wi-Fi Background Scanning (Stops the 60-second in-game ping spike!)" IsChecked="True"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="DNS Server Preset:" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbDnsPreset" Width="200" Height="34" SelectedIndex="0">
                                        <ComboBoxItem Content="Cloudflare (1.1.1.1)"/>
                                        <ComboBoxItem Content="Google (8.8.8.8)"/>
                                        <ComboBoxItem Content="Quad9 (9.9.9.9)"/>
                                        <ComboBoxItem Content="Default (DHCP/ISP)"/>
                                    </ComboBox>
                                    <Button x:Name="BtnApplyNetwork" Content="Apply Network Tweaks" Style="{StaticResource PinkButtonStyle}" Margin="12,0,0,0"/>
                                    <Button x:Name="BtnFlushDns" Content="Flush DNS Cache" Style="{StaticResource OutlineButtonStyle}" Margin="10,0,0,0"/>
                                </StackPanel>

                                <!-- YouTube Follow Along Banner -->
                                <Border Background="#201124" BorderBrush="{StaticResource PinkPrimary}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="📺 Ethernet Adapter Follow-Along Guide" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="Watch Kaiser's video to configure Device Manager Ethernet settings (Green Ethernet, Interrupt Moderation)." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnWatchEthernetVideo" Grid.Column="1" Content="▶ Watch Guide on YouTube" Style="{StaticResource PinkButtonStyle}" Padding="16,8"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- STEP 4 PANEL -->
                    <Border x:Name="PanelStep4" Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Step 4: NVIDIA GPU &amp; Driver Optimization" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Tune your graphics driver for ultra-low latency and maximum FPS in Roblox Rivals." FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"/>

                                <!-- Hardware Status Notification -->
                                <Border x:Name="BorderGpuNotice" Background="#100F1A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtGpuDetectStatus" Text="Detecting Graphics Hardware..." FontSize="13" FontWeight="Bold" Foreground="{StaticResource PinkPrimary}"/>
                                        <TextBlock Text="Notice: NVIDIA specific driver tweaks apply to NVIDIA GeForce GPUs. If you have AMD or Intel, you can safely skip this step." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Button x:Name="BtnOpenNvcpl" Content="🖥️ Open NVIDIA Control Panel" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,12,0"/>
                                    <Button x:Name="BtnWatchNvidiaVideo" Content="▶ Watch NVIDIA 3D Settings Follow-Along" Style="{StaticResource PinkButtonStyle}"/>
                                </StackPanel>

                                <!-- Completion Advice Box -->
                                <Border Background="#101B14" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="🎉 You Are All Done!" FontSize="14" FontWeight="Bold" Foreground="#4ADE80"/>
                                        <TextBlock Text="Once you have applied your chosen tweaks, RESTART your PC so Windows schedules all changes, then launch Roblox Rivals and enjoy smooth, high-FPS gameplay!" FontSize="11" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. Console Logs & Footer Action Bar -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Activity Log Window -->
                <Border Grid.Row="0" Background="{StaticResource ConsoleBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtConsoleLog" Background="Transparent" Foreground="#E0E0F0" BorderThickness="0" 
                                 FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <!-- Bottom Safety Actions -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="#2A1620" BorderBrush="#55FF2A85" BorderThickness="1" CornerRadius="6">
                        <Button x:Name="BtnRevertAll" Content="↺ Revert All Settings" Background="Transparent" Foreground="#FF6B8B" BorderThickness="0" Padding="12,5" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>

